DB_SSLMODE=require
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10
DJANGO_API_LOG_LEVEL=INFO
GOOGLE_BOOKS_API_KEY=demo-google-books-api-key
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
