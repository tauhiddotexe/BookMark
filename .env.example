DJANGO_SECRET_KEY=demo-django-secret-key
JWT_SECRET_KEY=demo-jwt-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000
